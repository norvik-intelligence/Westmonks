# Canonical production URL used for metadata, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://westmonks.vercel.app

# Server-only Google AI Studio key. Never prefix this variable with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Optional model override. The default supports URL Context and structured output.
GEMINI_MODEL=gemini-3.1-flash-lite
