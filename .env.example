# Kanonische Produktions-URL fuer Metadaten, Sitemap und robots.txt.
NEXT_PUBLIC_SITE_URL=https://westmonks.de

# --- Kontaktformular (SMTP, All-Inkl/KAS) ---
SMTP_HOST=w0218de2.kasserver.com
SMTP_PORT=465
SMTP_USER=hello@westmonks.de
# Nur in den Vercel-Umgebungsvariablen setzen, niemals im Repo.
SMTP_PASSWORD=
# Optional: abweichender Empfaenger. Ohne Angabe geht die Mail an SMTP_USER.
CONTACT_TO=hello@westmonks.de

# --- Shop-Analyse ---
# Server-seitiger Google-AI-Studio-Key. Niemals mit NEXT_PUBLIC_ praefixen.
GEMINI_API_KEY=
# Optionaler Modell-Override.
GEMINI_MODEL=gemini-3.1-flash-lite
