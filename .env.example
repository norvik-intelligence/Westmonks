# Canonical production URL used for metadata, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://westmonks.vercel.app

# Full Cal.com or Calendly event URL for the 15-minute strategy call.
NEXT_PUBLIC_BOOKING_URL=

# Legacy fallback. NEXT_PUBLIC_BOOKING_URL takes precedence.
NEXT_PUBLIC_CALENDLY_URL=

# Optional endpoint that accepts POST JSON: { email, source }
# When omitted, the PDF is downloaded locally without transmitting the email.
NEXT_PUBLIC_LEAD_ENDPOINT=
